{
  "name": "@zapier-clone/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit:engine": "node --max-old-space-size=2048 $(npx which vitest) run src/engine/__tests__/sequential-executor.test.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.65.0",
    "@zapier-clone/db": "workspace:*",
    "@zapier-clone/types": "workspace:*",
    "ajv": "^8.16.0",
    "axios": "^1.7.2",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "pino": "^10.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^5.13.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.0.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
